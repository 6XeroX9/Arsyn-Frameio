# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive (OAuth client for a Google Cloud project with the Drive API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Resend (for "new comment" email notifications) — optional for MVP
RESEND_API_KEY=
NOTIFY_EMAIL_TO=

# Telegram bot (for "review complete" notifications) — message @BotFather to create a bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail App Password (for "review complete" email notifications) — myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Dashboard login (bcrypt hash, never store the plain password) — generate
# with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
FRONTEND_URL=

PORT=8787
